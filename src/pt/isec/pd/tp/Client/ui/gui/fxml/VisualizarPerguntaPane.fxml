<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER" spacing="15.0"
      style="-fx-background-color: #f4f4f9; -fx-font-family: 'Arial', sans-serif;"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="pt.isec.pd.tp.Client.ui.gui.vistas.VisualizarPerguntaPane">

    <padding>
        <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
    </padding>

    <Label text="Detalhes da Pergunta"
           style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #333333; -fx-padding: 0 0 10 0;" />

    <Label text="Código de Acesso"
           style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #333333;" />

    <Label fx:id="lblCodigo" text=""
           style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #333333; -fx-padding: 0 0 10 0;" />

    <Separator style="-fx-pref-width: 700px; -fx-padding: 5 0 0 0;" />

    <Label text="Enunciado:"
           style="-fx-font-weight: bold; -fx-text-fill: #007bff; -fx-font-size: 16px;"/>

    <Label fx:id="lblEnunciado" style="-fx-fill: #333333; -fx-font-size: 16px;" />


    <Separator style="-fx-pref-width: 700px;" />

    <Label text="Opções de Resposta:"
           style="-fx-font-weight: bold; -fx-text-fill: #007bff; -fx-font-size: 16px;"/>
    <VBox fx:id="optionsDisplayContainer" alignment="CENTER" spacing="5.0" style="-fx-pref-width: 700px;" />

    <Separator style="-fx-pref-width: 700px;" />

    <HBox spacing="40.0" alignment="CENTER" style="-fx-padding: 5 0;">
        <VBox spacing="5.0" alignment="CENTER" style="-fx-border-color: #cccccc; -fx-border-radius: 5; -fx-padding: 10; -fx-background-color: white; -fx-pref-width: 180px;">
            <Label text="Opção Correta (Índice):" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #6c757d;" />
            <Label fx:id="lblOpcaoCorreta" text="?" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #28a745;" />
        </VBox>

        <VBox spacing="5.0" alignment="CENTER" style="-fx-border-color: #cccccc; -fx-border-radius: 5; -fx-padding: 10; -fx-background-color: white; -fx-pref-width: 250px;">
            <Label text="Data/Hora de Início:" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #6c757d;" />
            <Label fx:id="lblDataInicio" text="YYYY/MM/DD HH:MM" style="-fx-font-size: 14px; -fx-text-fill: #333333;" />
        </VBox>

        <VBox spacing="5.0" alignment="CENTER" style="-fx-border-color: #cccccc; -fx-border-radius: 5; -fx-padding: 10; -fx-background-color: white; -fx-pref-width: 250px;">
            <Label text="Data/Hora de Fim:" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #6c757d;" />
            <Label fx:id="lblDataFim" text="YYYY/MM/DD HH:MM" style="-fx-font-size: 14px; -fx-text-fill: #333333;" />
        </VBox>
    </HBox>

    <Separator style="-fx-pref-width: 700px;" />

    <HBox fx:id="boxEstatisticas" spacing="40" alignment="CENTER" visible="false" managed="false" style="-fx-padding: 5 0;">
        <Label text="Respostas Total:" style="-fx-font-weight: bold; -fx-text-fill: #333333;"/>
        <Label fx:id="lblRespostas" text="0" style="-fx-font-weight: bold; -fx-text-fill: #007bff;"/>

        <Label text="Percentagem Certas:" style="-fx-font-weight: bold; -fx-text-fill: #333333;"/>
        <Label fx:id="lblPercentagemCertas" text="0%" style="-fx-font-weight: bold; -fx-text-fill: #28a745;"/>
    </HBox>

    <Separator fx:id="separatorEstatisticas" style="-fx-pref-width: 700px;" visible="false" managed="false" />


    <TableView fx:id="tableViewRespostas" visible="false" managed="false" prefWidth="720"
               style="-fx-background-color: white; -fx-border-color: #cccccc; -fx-border-width: 1; -fx-border-radius: 5; -fx-font-size: 13px;">
        <columns>
            <TableColumn fx:id="colNrEstudante" text="Nº Estudante" prefWidth="120" style="-fx-alignment: CENTER; -fx-font-weight: bold;"/>
            <TableColumn fx:id="colNome" text="Nome" prefWidth="170" style="-fx-alignment: CENTER_LEFT; -fx-font-weight: bold;"/>
            <TableColumn fx:id="colEmail" text="Email" prefWidth="210" style="-fx-alignment: CENTER_LEFT; -fx-font-weight: bold;"/>
            <TableColumn fx:id="colResposta" text="Resposta Escolhida" prefWidth="120" style="-fx-alignment: CENTER; -fx-font-weight: bold;"/>
            <TableColumn fx:id="colDataHora" text="Data/Hora" prefWidth="100" style="-fx-alignment: CENTER; -fx-font-weight: bold;"/>
        </columns>
        <VBox.vgrow>ALWAYS</VBox.vgrow>
    </TableView>


    <HBox spacing="15" alignment="CENTER" style="-fx-padding: 20 0 0 0;">
        <Button text="Editar Pergunta" onAction="#onEditarPergunta"
                style="-fx-background-color: #007bff; -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold; -fx-pref-width: 170px; -fx-pref-height: 40px; -fx-background-radius: 8; -fx-cursor: hand;"/>

        <Button text="Eliminar Pergunta" onAction="#onEliminarPergunta"
                style="-fx-background-color: #dc3545; -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold; -fx-pref-width: 170px; -fx-pref-height: 40px; -fx-background-radius: 8; -fx-cursor: hand;"/>

        <Button fx:id="btnVerResultados" text="Ver Resultados" onAction="#onVerResultados" visible="false" managed="false"
                style="-fx-background-color: #ffc107; -fx-text-fill: #333333; -fx-font-size: 16px; -fx-font-weight: bold; -fx-pref-width: 140px; -fx-pref-height: 40px; -fx-background-radius: 8; -fx-cursor: hand;"/>

        <Button fx:id="btnExportarCsv" text="Exportar CSV" onAction="#onExportarCsv" visible="false" managed="false"
                style="-fx-background-color: #28a745; -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold; -fx-pref-width: 140px; -fx-pref-height: 40px; -fx-background-radius: 8; -fx-cursor: hand;"/>
    </HBox>

    <HBox spacing="10" alignment="CENTER" style="-fx-padding: 20 0 0 0;">
        <Button text="Voltar" onAction="#onBack"
                style="-fx-background-color: #6c757d; -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold; -fx-pref-width: 120px; -fx-pref-height: 40px; -fx-background-radius: 8; -fx-cursor: hand;" />
    </HBox>

</VBox>