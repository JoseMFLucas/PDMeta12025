<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="10.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pt.isec.pd.tp.Client.ui.gui.vistas.EstudanteHomePage">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label text="Página Inicial do Estudante" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
    <Button onAction="#onResponderPergunta" text="Responder a Pergunta" />
    <Button onAction="#onListarPerguntasRespondidas" text="Ver Histórico de Respostas" />
    <Button onAction="#onEditarPerfilEstudante" text="Editar Perfil de Estudante" />
</VBox>
