<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="15.0"
      style="-fx-background-color: #f4f4f9; -fx-font-family: 'Arial', sans-serif;"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="pt.isec.pd.tp.Client.ui.gui.vistas.EstudanteHomePage">

    <padding>
        <Insets bottom="50.0" left="50.0" right="50.0" top="50.0" />
    </padding>

    <Label text="Área do Estudante"
           style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #333333; -fx-padding: 0 0 20 0;" />

    <Label text="Selecione uma opção abaixo:"
           style="-fx-font-size: 16px; -fx-text-fill: #6c757d; -fx-padding: 0 0 10 0;" />

    <Button onAction="#onResponderPergunta" text="Responder a Pergunta"
            style="-fx-background-color: #007bff; -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold; -fx-pref-width: 250px; -fx-pref-height: 45px; -fx-background-radius: 8; -fx-cursor: hand;" />

    <Button onAction="#onListarPerguntasRespondidas" text="Ver Histórico de Respostas"
            style="-fx-background-color: #007bff; -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold; -fx-pref-width: 250px; -fx-pref-height: 45px; -fx-background-radius: 8; -fx-cursor: hand;" />

    <Label VBox.vgrow="ALWAYS" minHeight="5.0" />

    <Button onAction="#onEditarPerfilEstudante" text="Editar Perfil de Estudante"
            style="-fx-background-color: #ffffff; -fx-text-fill: #007bff; -fx-font-size: 16px; -fx-font-weight: bold; -fx-pref-width: 250px; -fx-pref-height: 45px; -fx-background-radius: 8; -fx-cursor: hand;" />

    <Button onAction="#onLogout" text="Logout"
            style="-fx-background-color: #dc3545; -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold; -fx-pref-width: 250px; -fx-pref-height: 45px; -fx-background-radius: 8; -fx-cursor: hand;" />

</VBox>