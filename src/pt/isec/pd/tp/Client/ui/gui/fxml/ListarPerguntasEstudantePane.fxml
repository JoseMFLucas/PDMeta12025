<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" spacing="15.0"
      style="-fx-background-color: #f4f4f9; -fx-font-family: 'Arial', sans-serif;"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="pt.isec.pd.tp.Client.ui.gui.vistas.ListarPerguntasEstudantePane">

    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
    </padding>

    <Label text="Histórico de Respostas"
           style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #333333; -fx-padding: 0 0 10 0;" />

    <TableView fx:id="tableViewPerguntas"
               style="-fx-background-color: white; -fx-border-color: #cccccc; -fx-border-width: 1; -fx-border-radius: 5; -fx-pref-width: 650px; -fx-max-height: 400px; -fx-font-size: 14px;">
        <columns>
            <TableColumn fx:id="colEnunciado" text="Enunciado da Pergunta" prefWidth="250"
                         style="-fx-alignment: CENTER; -fx-font-weight: bold;"/>
            <TableColumn fx:id="colData" text="Data da Resposta" prefWidth="150"
                         style="-fx-alignment: CENTER; -fx-font-weight: bold;"/>
            <TableColumn fx:id="colOpcao" text="Sua Opção" prefWidth="100"
                         style="-fx-alignment: CENTER; -fx-font-weight: bold;"/>
            <TableColumn fx:id="colResultado" text="Resultado" prefWidth="150"
                         style="-fx-alignment: CENTER; -fx-font-weight: bold;"/>
        </columns>
        <VBox.vgrow>ALWAYS</VBox.vgrow> </TableView>

    <Button text="Voltar" onAction="#onBack"
            style="-fx-background-color: #6c757d; -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold; -fx-pref-width: 150px; -fx-pref-height: 40px; -fx-background-radius: 8; -fx-cursor: hand;">
        <VBox.margin>
            <Insets top="10.0" />
        </VBox.margin>
    </Button>

</VBox>
