<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="10.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pt.isec.pd.tp.Client.ui.gui.vistas.RegisterPage">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label text="Registar" />

    <HBox alignment="CENTER" spacing="10.0">
        <RadioButton fx:id="rbEstudante" onAction="#onUserTypeSelect" text="Estudante">
            <toggleGroup>
                <ToggleGroup fx:id="userTypeGroup" />
            </toggleGroup>
        </RadioButton>
        <RadioButton fx:id="rbDocente" onAction="#onUserTypeSelect" text="Docente" toggleGroup="$userTypeGroup" />
    </HBox>

    <TextField fx:id="txtNumero" managed="false" promptText="Número de Estudante" visible="false" />
    <TextField fx:id="txtNome" promptText="Nome" />
    <TextField fx:id="txtEmail" promptText="Email" />
    <PasswordField fx:id="txtPass" promptText="Password" />
    <TextField fx:id="txtCodigo" managed="false" promptText="Código de Docente" visible="false" />


    <Button fx:id="btnRegistar" onAction="#onRegister" text="Registar" />
    <Button fx:id="btnVoltar" onAction="#onBack" text="Voltar" />
</VBox>
